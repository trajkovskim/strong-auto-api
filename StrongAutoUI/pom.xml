<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.example</groupId>
    <artifactId>StrongAuto</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>StrongAutoUI</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>strongauto-ui-build</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>copy strong auto api spec</id>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.example</groupId>
                      <artifactId>StrongAutoRestApi</artifactId>
                      <type>jar</type>
                    </artifactItem>
                  </artifactItems>
                  <overWriteIfNewer>true</overWriteIfNewer>
                  <overWriteSnapshots>true</overWriteSnapshots>
                  <includes>**/*.yaml</includes>
                  <outputDirectory>src/main/ui/docs</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <configuration>
              <nodeVersion>v20.0.0</nodeVersion>
              <yarnVersion>v1.22.19</yarnVersion>
              <workingDirectory>src/main/ui</workingDirectory>
            </configuration>
            <executions>
              <execution>
                <id>install node and yarn</id>
                <goals>
                  <goal>install-node-and-yarn</goal>
                </goals>
              </execution>
              <execution>
                <id>yarn install</id>
                <goals>
                  <goal>yarn</goal>
                </goals>
              </execution>
              <execution>
                <id>yarn generate types</id>
                <goals>
                  <goal>yarn</goal>
                </goals>
                <configuration>
                  <arguments>generate-types</arguments>
                </configuration>
              </execution>
              <execution>
                <id>yarn build</id>
                <goals>
                  <goal>yarn</goal>
                </goals>
                <configuration>
                  <arguments>build</arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
